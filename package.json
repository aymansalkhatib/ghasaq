{
  "name": "ghasaq",
  "private": true,
  "version": "2.2.0",
  "description": "Ghasaq: an Arabic-language, first-person survival shooter for the browser. Hold a desert fortress from 16:00 to midnight. Built with Three.js, cannon-es and Vite; every texture, model and sound is generated in code.",
  "keywords": [
    "game",
    "fps",
    "first-person-shooter",
    "browser-game",
    "threejs",
    "webgl",
    "cannon-es",
    "vite",
    "web-audio",
    "procedural",
    "arabic",
    "rtl"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "build:single": "node scripts/build-single.mjs"
  },
  "dependencies": {
    "cannon-es": "0.20.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@fontsource/changa": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "vite": "^6.0.7"
  }
}
